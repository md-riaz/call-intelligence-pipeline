# Copy to config.env to set defaults used when CLI flags are omitted.
#   cp config.example.env config.env
# CLI flags always override this file.

# ──────────────────────────────────────────────────────────────────────
# Google Gemini API keys
# ──────────────────────────────────────────────────────────────────────

# Option A — comma-separated (easiest to paste multiple keys)
# Each key is from a different Google AI Studio project = separate daily quota.
# 3 keys × 500 RPD (lite) = 1,500 free transcriptions/day.
# GOOGLE_API_KEYS=AIzaSy...key1,AIzaSy...key2,AIzaSy...key3

# Option B — numbered keys (easier to enable/disable one key at a time)
# GOOGLE_API_KEY_1=AIzaSy...key1
# GOOGLE_API_KEY_2=AIzaSy...key2
# GOOGLE_API_KEY_3=AIzaSy...key3

# Option C — single key (original format, still works)
# GOOGLE_API_KEY=AIzaSy...key

# ──────────────────────────────────────────────────────────────────────
# Gemini model selection
# ──────────────────────────────────────────────────────────────────────
# gemini-3.1-flash-lite  — 500 RPD free  (default, recommended for production)
# gemini-2.5-flash       — 20 RPD free   (higher quality, lower daily limit)
GEMINI_MODEL=gemini-3.1-flash-lite
