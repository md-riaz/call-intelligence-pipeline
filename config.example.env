# Copy to config.env to set defaults used when CLI flags are omitted.
# CLI flags always override this file.

# Public ASR service defaults
MODEL_PROVIDER=whisper-bn
WHISPER_MODEL=bitwisemind/sam_15000_clean_text_full_model
ASR_QUEUE_DB=./transcripts/transcription_queue.sqlite3
ASR_UPLOAD_DIR=./transcripts/uploads
ASR_OUTPUT_DIR=./transcripts

# OpenAI-compatible call QA analysis
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Legacy remote Gemini ASR settings retained only for backwards-compatible local CLI paths.
# The public FastAPI ASR service does not expose Gemini model selection.
GEMINI_MODEL=gemini-3.1-flash-lite
