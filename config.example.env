# Copy to config.env to set defaults used when CLI flags are omitted.
#   cp config.example.env config.env
# setup.sh writes this automatically. CLI flags always override it.

# Default Whisper model: tiny | base | small | medium | large-v2 | large-v3
# large-v3 is strongly recommended for accuracy and noise robustness.
WHISPER_MODEL=large-v3
